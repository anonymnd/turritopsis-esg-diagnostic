{
  "name": "turritopsis-esg-diagnostic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "dev:api": "dotnet run --project backend/src/Turritopsis.Api --launch-profile http",
    "build": "npm --prefix frontend run build",
    "build:api": "dotnet build backend/Turritopsis.sln",
    "test:privacy": "dotnet run --project backend/tests/Turritopsis.PrivacyChecks",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview -- --host 127.0.0.1",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm run build && npm run lint && npm run build:api && npm run test:privacy && npm run test:modules && npm run test:push",
    "test:modules": "dotnet run --project backend/tests/Turritopsis.ModuleChecks",
    "test:modules:db": "dotnet run --project backend/tests/Turritopsis.ModuleChecks -- --database",
    "test:push": "npm --prefix frontend run test:push",
    "test:e2e": "npm --prefix frontend run test:e2e"
  }
}
